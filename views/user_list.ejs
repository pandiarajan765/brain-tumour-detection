<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h2 class="fw-extrabold text-dark mb-1 d-flex align-items-center gap-2">
      <i class="fas fa-users text-teal" style="color: #14b8a6;"></i>
      <span>User Management</span>
    </h2>
    <p class="text-muted small mb-0">Manage registered system users, assign admin roles, and update account statuses.</p>
  </div>
  <a href="/admin/users/create" class="btn btn-success btn-sm d-inline-flex align-items-center gap-2 shadow-sm">
    <i class="fas fa-plus"></i> Add New User
  </a>
</div>

<form class="row g-2 mb-4" method="GET" action="/admin/users">
  <div class="col-md-5 col-lg-4">
    <div class="input-group">
      <input type="text" name="search" class="form-control" placeholder="Search by name or email..." value="<%= search %>">
      <button class="btn btn-primary px-3" type="submit"><i class="fas fa-search"></i></button>
    </div>
  </div>
</form>

<div class="card shadow-sm border-0 mb-4 overflow-hidden">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-dark text-uppercase extra-small">
          <tr>
            <th class="ps-4">#</th>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Created</th>
            <th class="text-end pe-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (users.length === 0) { %>
            <tr><td colspan="7" class="text-center py-5 text-muted">No registered users found matching query.</td></tr>
          <% } %>
          <% users.forEach((u, i) => { %>
          <tr>
            <td class="ps-4 fw-bold text-muted"><%= (page - 1) * 10 + i + 1 %></td>
            <td class="fw-bold text-dark"><i class="fas fa-user-circle text-teal me-2" style="color: #14b8a6;"></i><%= u.name %></td>
            <td class="text-secondary"><%= u.email %></td>
            <td>
              <% if (u.role === 'admin') { %>
                <span class="badge bg-warning text-dark"><i class="fas fa-user-shield me-1"></i>Admin</span>
              <% } else { %>
                <span class="badge bg-info text-white"><i class="fas fa-user me-1"></i>User</span>
              <% } %>
            </td>
            <td>
              <% if (u.status === 'active') { %>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1"><i class="fas fa-check-circle me-1"></i>Active</span>
              <% } else { %>
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1">Inactive</span>
              <% } %>
            </td>
            <td class="text-muted extra-small"><%= new Date(u.createdAt).toLocaleDateString() %></td>
            <td class="text-end pe-4">
              <a href="/admin/users/<%= u._id %>/edit" class="btn btn-sm btn-outline-primary me-1" title="Edit User"><i class="fas fa-edit"></i></a>
              <form action="/admin/users/<%= u._id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('Are you sure you want to delete this user?')">
                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete User"><i class="fas fa-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if (totalPages > 1) { %>
<nav class="mt-4">
  <ul class="pagination justify-content-center">
    <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
      <a class="page-link" href="/admin/users?page=<%= page - 1 %>&search=<%= search %>">Previous</a>
    </li>
    <% for (let p = 1; p <= totalPages; p++) { %>
      <li class="page-item <%= p === page ? 'active' : '' %>">
        <a class="page-link" href="/admin/users?page=<%= p %>&search=<%= search %>"><%= p %></a>
      </li>
    <% } %>
    <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
      <a class="page-link" href="/admin/users?page=<%= page + 1 %>&search=<%= search %>">Next</a>
    </li>
  </ul>
</nav>
<% } %>

<a href="/admin" class="btn btn-outline-secondary btn-sm mb-4"><i class="fas fa-arrow-left me-1"></i> Back to Dashboard</a>
<%- include('partials/footer') %>
