<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h2 class="fw-extrabold text-dark mb-1 d-flex align-items-center gap-2">
      <i class="fas fa-user-shield text-teal" style="color: #14b8a6;"></i>
      <span>Admin Dashboard</span>
    </h2>
    <p class="text-muted small mb-0">System performance overview, user management, and activity logs.</p>
  </div>
  <a href="/admin/users" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-2 shadow-sm">
    <i class="fas fa-users-cog"></i> Manage Users
  </a>
</div>

<!-- Admin Stat Cards Grid -->
<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card h-100 shadow-sm border-0 stat-card-primary">
      <div class="card-body p-4 text-center">
        <div class="stat-icon-wrapper mx-auto mb-2 text-white bg-primary shadow-sm" style="width: 52px; height: 52px; border-radius: 1rem;">
          <i class="fas fa-users fs-4"></i>
        </div>
        <h2 class="display-6 fw-extrabold mb-1 text-dark"><%= totalUsers %></h2>
        <p class="text-secondary fw-bold extra-small text-uppercase mb-0" style="letter-spacing: 0.05em;">Total Users</p>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card h-100 shadow-sm border-0 stat-card-success">
      <div class="card-body p-4 text-center">
        <div class="stat-icon-wrapper mx-auto mb-2 text-white bg-success shadow-sm" style="width: 52px; height: 52px; border-radius: 1rem;">
          <i class="fas fa-microscope fs-4"></i>
        </div>
        <h2 class="display-6 fw-extrabold mb-1 text-dark"><%= totalScans %></h2>
        <p class="text-secondary fw-bold extra-small text-uppercase mb-0" style="letter-spacing: 0.05em;">Scans Processed</p>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card h-100 shadow-sm border-0 stat-card-danger">
      <div class="card-body p-4 text-center">
        <div class="stat-icon-wrapper mx-auto mb-2 text-white bg-danger shadow-sm" style="width: 52px; height: 52px; border-radius: 1rem;">
          <i class="fas fa-exclamation-triangle fs-4"></i>
        </div>
        <h2 class="display-6 fw-extrabold mb-1 text-dark"><%= tumourDetected %></h2>
        <p class="text-secondary fw-bold extra-small text-uppercase mb-0" style="letter-spacing: 0.05em;">Tumours Detected</p>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card h-100 shadow-sm border-0 stat-card-warning">
      <div class="card-body p-4 text-center">
        <div class="stat-icon-wrapper mx-auto mb-2 text-dark bg-warning shadow-sm" style="width: 52px; height: 52px; border-radius: 1rem;">
          <i class="fas fa-comments fs-4"></i>
        </div>
        <h2 class="display-6 fw-extrabold mb-1 text-dark"><%= pendingFeedback %></h2>
        <p class="text-secondary fw-bold extra-small text-uppercase mb-0" style="letter-spacing: 0.05em;">Pending Feedback</p>
      </div>
    </div>
  </div>
</div>

<!-- Logs & Pending Feedback Grid -->
<div class="row g-4 mb-4">
  <div class="col-lg-6">
    <div class="card h-100 shadow-sm border-0 overflow-hidden">
      <div class="card-header py-3 bg-dark text-white d-flex align-items-center justify-content-between">
        <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
          <i class="fas fa-history" style="color: #14b8a6;"></i> Activity Logs
        </h5>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-dark text-uppercase extra-small">
              <tr>
                <th class="ps-4">User</th>
                <th>Action</th>
                <th>Time</th>
              </tr>
            </thead>
            <tbody>
              <% if(recentLogs && recentLogs.length > 0){ %>
                <% recentLogs.forEach(l=>{ %>
                  <tr>
                    <td class="ps-4 fw-semibold text-dark"><i class="fas fa-user-circle text-muted me-1.5"></i><%= l.userId ? l.userId.name : 'System' %></td>
                    <td><span class="badge bg-secondary-subtle text-secondary border px-2 py-1"><%= l.activityType %></span></td>
                    <td class="text-muted extra-small"><%= new Date(l.createdAt).toLocaleString() %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="3" class="text-center py-4 text-muted">No activity logs recorded.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card h-100 shadow-sm border-0 overflow-hidden">
      <div class="card-header py-3 bg-dark text-white d-flex align-items-center justify-content-between">
        <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
          <i class="fas fa-comment-dots" style="color: #14b8a6;"></i> Pending Feedback
        </h5>
      </div>
      <div class="card-body p-4">
        <% if(feedbacks && feedbacks.length > 0){ %>
          <% feedbacks.forEach(f=>{ %>
            <div class="p-3 mb-3 border rounded-3 bg-light">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                  <span class="fw-bold text-dark"><i class="fas fa-user me-1 text-teal" style="color: #14b8a6;"></i><%= f.lastName ? f.lastName : (f.userId ? f.userId.name : 'User') %></span>
                  <% if (f.phone) { %>
                    <span class="text-muted extra-small ms-2"><i class="fas fa-phone-alt me-1"></i><%= f.phone %></span>
                  <% } %>
                </div>
                <span class="badge bg-warning text-dark"><i class="fas fa-star me-1"></i><%= f.rating %>/5</span>
              </div>
              <p class="text-secondary small mb-2"><%= f.comments %></p>
              <form action="/admin/feedback/<%= f._id %>/respond" method="POST" class="d-flex gap-2">
                <input type="text" name="response" class="form-control form-control-sm" placeholder="Write admin response..." required>
                <button class="btn btn-sm btn-success px-3 fw-bold flex-shrink-0">Send</button>
              </form>
            </div>
          <% }) %>
        <% } else { %>
          <div class="text-center py-4 text-muted">
            <i class="fas fa-check-circle fs-2 text-success mb-2"></i>
            <p class="mb-0">All user feedbacks have been responded to!</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>