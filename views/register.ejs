<%- include('partials/header') %>

<div class="row justify-content-center mt-3 mt-md-4 mb-5">
  <div class="col-lg-10 col-xl-9">
    <div class="card shadow-lg border-0 overflow-hidden" style="border-radius: 1.5rem;">
      <div class="row g-0 auth-card-row">
        <!-- Left Side: Modern Medical Gradient Overlay -->
        <div class="col-md-5 d-none d-md-flex align-items-center justify-content-center position-relative text-white hero-gradient-card auth-card-col-left" 
             style="background: linear-gradient(135deg, #070d19 0%, #0f172a 50%, #0f766e 100%); min-height: 520px;">
          <div class="position-relative text-center p-4 p-lg-5 z-1">
            <div class="stat-icon-wrapper bg-white-10 mx-auto mb-3" style="width: 72px; height: 72px; background: rgba(255,255,255,0.1); border-radius: 1.25rem;">
              <i class="fas fa-user-plus brand-icon-glow" style="color: #14b8a6; font-size: 2rem;"></i>
            </div>
            <h1 class="display-6 fw-extrabold mb-2 text-white">Join Platform</h1>
            <p class="fs-6 text-light opacity-90 mb-0">Create your user account to analyze MRI scans and access diagnostic history.</p>
          </div>
        </div>
        
        <!-- Right Side: Registration Form -->
        <div class="col-md-7 d-flex align-items-center auth-form-container auth-card-col-right">
          <div class="card-body p-4 p-md-5 w-100">
            <h2 class="fw-extrabold mb-1 auth-heading">Create Account ✨</h2>
            <p class="text-muted mb-4 small">Fill in your information to get started</p>
            
            <form action="/register" method="POST">
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label text-secondary fw-bold extra-small">Full Name <span class="text-danger">*</span></label>
                  <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="fas fa-user"></i></span>
                    <input type="text" name="name" class="form-control bg-light" placeholder="John Doe" required>
                  </div>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label text-secondary fw-bold extra-small">Email Address <span class="text-danger">*</span></label>
                  <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="fas fa-envelope"></i></span>
                    <input type="email" name="email" class="form-control bg-light" placeholder="john@example.com" required>
                  </div>
                </div>
              </div>
              
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label text-secondary fw-bold extra-small">Password <span class="text-danger">*</span></label>
                  <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="fas fa-lock"></i></span>
                    <input type="password" name="password" class="form-control bg-light" placeholder="••••••••" required minlength="6">
                    <button type="button" class="btn btn-outline-secondary toggle-password-btn" aria-label="Toggle password visibility">
                      <i class="fas fa-eye"></i>
                    </button>
                  </div>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label text-secondary fw-bold extra-small">Phone Number</label>
                  <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="fas fa-phone"></i></span>
                    <input type="text" name="phone" class="form-control bg-light" placeholder="+1 (555) 000-0000">
                  </div>
                </div>
              </div>
              
              <div class="row mb-4">
                <div class="col-md-6 mb-3 mb-md-0">
                  <label class="form-label text-secondary fw-bold extra-small">Date of Birth</label>
                  <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="fas fa-calendar"></i></span>
                    <input type="date" name="dob" class="form-control bg-light">
                  </div>
                </div>
                <div class="col-md-6">
                  <label class="form-label text-secondary fw-bold extra-small">Gender</label>
                  <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="fas fa-venus-mars"></i></span>
                    <select name="gender" class="form-select bg-light">
                      <option>Male</option>
                      <option>Female</option>
                      <option>Other</option>
                    </select>
                  </div>
                </div>
              </div>
              
              <button type="submit" class="btn btn-primary w-100 py-3 fw-bold shadow-md">
                <span>Complete Registration</span>
                <i class="fas fa-user-check ms-2"></i>
              </button>
            </form>
            
            <div class="text-center mt-4 pt-2">
              <p class="text-muted small mb-0">
                Already have an account? 
                <a href="/login" class="fw-bold text-teal" style="color: #14b8a6;">Login here</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>