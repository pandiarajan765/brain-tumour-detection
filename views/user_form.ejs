<%- include('partials/header') %>
<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card shadow">
      <div class="card-header bg-primary text-white">
        <h4 class="mb-0"><i class="fas fa-user-<%= editUser ? 'edit' : 'plus' %>"></i> <%= editUser ? 'Edit' : 'Create' %> User</h4>
      </div>
      <div class="card-body">
        <form action="<%= editUser ? '/admin/users/' + editUser._id : '/admin/users' %>" method="POST">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Name <span class="text-danger">*</span></label>
              <input type="text" name="name" class="form-control" value="<%= editUser ? editUser.name : '' %>" required>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Email <span class="text-danger">*</span></label>
              <input type="email" name="email" class="form-control" value="<%= editUser ? editUser.email : '' %>" required>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Password <%= editUser ? '(leave blank to keep current)' : '' %> <% if (!editUser) { %><span class="text-danger">*</span><% } %></label>
              <input type="password" name="password" class="form-control" <%= editUser ? '' : 'required' %> minlength="6">
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Phone</label>
              <input type="text" name="phone" class="form-control" value="<%= editUser ? (editUser.phone || '') : '' %>">
            </div>
          </div>
          <div class="row">
            <div class="col-md-3 mb-3">
              <label class="form-label">DOB</label>
              <input type="date" name="dob" class="form-control" value="<%= editUser && editUser.dob ? new Date(editUser.dob).toISOString().split('T')[0] : '' %>">
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">Gender</label>
              <select name="gender" class="form-select">
                <option value="Male" <%= editUser && editUser.gender === 'Male' ? 'selected' : '' %>>Male</option>
                <option value="Female" <%= editUser && editUser.gender === 'Female' ? 'selected' : '' %>>Female</option>
                <option value="Other" <%= editUser && editUser.gender === 'Other' ? 'selected' : '' %>>Other</option>
              </select>
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">Role</label>
              <select name="role" class="form-select">
                <option value="user" <%= editUser && editUser.role === 'user' ? 'selected' : '' %>>User</option>
                <option value="admin" <%= editUser && editUser.role === 'admin' ? 'selected' : '' %>>Admin</option>
              </select>
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">Status</label>
              <select name="status" class="form-select">
                <option value="active" <%= editUser && editUser.status === 'active' ? 'selected' : '' %>>Active</option>
                <option value="inactive" <%= editUser && editUser.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
              </select>
            </div>
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <%= editUser ? 'Update' : 'Create' %> User</button>
            <a href="/admin/users" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
