<%- include('partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="fw-bold text-dark"><i class="fas fa-file-medical me-2 text-primary"></i>My Medical Reports</h2>
  <a href="/scan/upload" class="btn btn-primary"><i class="fas fa-upload me-2"></i>New Scan</a>
</div>

<% if(reports && reports.length > 0){ %>
  <div class="row">
    <% reports.forEach(r => { %>
      <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm border-0" style="border-radius: 1rem; transition: transform 0.2s;">
          <div class="card-body d-flex flex-column p-4">
            <div class="d-flex align-items-center mb-3">
              <div class="rounded-circle bg-light p-3 me-3 text-primary d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                <i class="fas fa-notes-medical fs-4"></i>
              </div>
              <div class="flex-grow-1">
                <h5 class="card-title fw-bold mb-1 text-dark"><%= r.patientName || (r.resultId && r.resultId.patientName) || 'Diagnostic Report' %></h5>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                  <span class="badge bg-teal-subtle text-teal font-monospace extra-small" style="background-color: rgba(20, 184, 166, 0.15) !important; color: #14b8a6 !important;">
                    <i class="fas fa-id-badge me-1"></i><%= r.patientId || (r.resultId && r.resultId.patientId) || 'N/A' %>
                  </span>
                  <% if(r.patientAge || (r.resultId && r.resultId.patientAge)){ %>
                    <span class="extra-small text-secondary fw-semibold"><i class="fas fa-birthday-cake me-1 text-muted"></i><%= r.patientAge || r.resultId.patientAge %> yrs</span>
                  <% } %>
                  <small class="text-muted ms-auto"><%= new Date(r.createdAt || Date.now()).toLocaleDateString() %></small>
                </div>
              </div>
            </div>
            <p class="card-text text-secondary flex-grow-1 text-truncate-2">
              <%= r.findings || 'No findings available.' %>
            </p>
            <div class="mt-3">
              <a href="/report/<%= r._id %>" class="btn btn-outline-primary btn-sm w-100 py-2 fw-semibold" style="border-radius: 0.5rem;">
                <i class="fas fa-eye me-1"></i> View Report
              </a>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="card shadow-sm border-0 text-center py-5" style="border-radius: 1rem;">
    <div class="card-body">
      <i class="fas fa-folder-open text-muted mb-3" style="font-size: 4rem;"></i>
      <h4 class="text-secondary fw-bold">No reports yet</h4>
      <p class="text-muted mb-4">Upload an MRI scan to generate diagnosis and reports.</p>
      <a href="/scan/upload" class="btn btn-primary"><i class="fas fa-upload me-2"></i>Upload Scan</a>
    </div>
  </div>
<% } %>
<%- include('partials/footer') %>